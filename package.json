{
    "name": "agent-roster-for-copilot-chat",
    "displayName": "Aro: Agent Roster Orchestrator for Copilot Chat",
    "description": "A specialist agent roster and reusable workflow skills for GitHub Copilot Chat.",
    "icon": "assets/extension-icon.png",
    "version": "0.0.0",
    "publisher": "UtopikPrompt",
    "main": "./src/extension.js",
    "activationEvents": [
        "onCommand:agentRoster.openModelLearning",
        "onCommand:agentRoster.openModelInventory",
        "onCommand:agentRoster.openEvidenceDashboard",
        "onView:agentRoster.modelLearning",
        "onLanguageModelTool:aroGetModelRecommendations",
        "onLanguageModelTool:aroRecordModelOutcome",
        "onLanguageModelTool:aroGetSkillProcedure",
        "onLanguageModelTool:aro_read_prior_assessment_store",
        "onLanguageModelTool:aro_write_evidence_batch",
        "onLanguageModelTool:aro_read_evidence_batch_page"
    ],
    "license": "PolyForm-Noncommercial-1.0.0",
    "engines": {
        "vscode": "^1.111.0"
    },
    "extensionDependencies": [
        "GitHub.copilot-chat"
    ],
    "categories": [
        "AI",
        "Chat"
    ],
    "keywords": [
        "copilot",
        "agents",
        "skills",
        "orchestrator"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/UtopikPrompt/agent-roster-for-copilot-chat.git"
    },
    "scripts": {
        "test": "node --test",
        "test:skip": "node -e \"console.warn('TESTS SKIPPED FOR DEBUGGING: no tests were run')\"",
        "lint": "node scripts/validate.mjs",
        "vscode:prepublish": "npm test && npm run lint",
        "package": "vsce package"
    },
    "contributes": {
        "configuration": {
            "title": "Agent Roster",
            "properties": {
                "agentRoster.modelLearning.localModelVendors": {
                    "type": "array",
                    "scope": "machine",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Exact VS Code vendor IDs for local model providers to include in Aro recommendations. Models from these vendors are treated as having zero token charges; hardware and energy costs are not estimated. Only add providers that run locally. Copilot models are always included."
                },
                "agentRoster.modelRecommendation.preferredProvider": {
                    "type": "string",
                    "scope": "window",
                    "default": "",
                    "description": "Exact VS Code vendor ID that Aro should prefer among eligible models in this workspace. Ignored when no eligible model from this provider exists; the existing recommendation applies. Leave empty for no preference."
                },
                "agentRoster.modelRecommendation.preferredModel": {
                    "type": "string",
                    "scope": "window",
                    "default": "",
                    "description": "Exact model ID to prefer within agentRoster.modelRecommendation.preferredProvider. Requires a provider and is ignored when that model is not currently eligible. Manual model selections still take precedence."
                },
                "agentRoster.modelRecommendation.enabledProviders": {
                    "type": "array",
                    "scope": "window",
                    "items": {
                        "type": "string"
                    },
                    "markdownDescription": "Exact VS Code vendor IDs Aro may use in this workspace. When set, this list overrides the global provider availability and can re-enable a provider disabled globally. When unset, the global list applies. Manage it from **Agent Roster: Open Model Inventory** (Workspace tab)."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "agentRoster",
                    "title": "Agent Roster",
                    "icon": "assets/aro-wireframe.svg"
                }
            ]
        },
        "views": {
            "agentRoster": [
                {
                    "id": "agentRoster.modelLearning",
                    "name": "Aro Learning"
                }
            ]
        },
        "commands": [
            {
                "command": "agentRoster.openModelLearning",
                "title": "Agent Roster: Open Aro Learning"
            },
            {
                "command": "agentRoster.pinAdvisorModel",
                "title": "Agent Roster: Set Aro/Advisor Default Model"
            },
            {
                "command": "agentRoster.changeModelScope",
                "title": "Agent Roster: Change Model Scope"
            },
            {
                "command": "agentRoster.changeModelPriority",
                "title": "Agent Roster: Change Model Priority"
            },
            {
                "command": "agentRoster.openModelInventory",
                "title": "Agent Roster: Open Model Inventory"
            },
            {
                "command": "agentRoster.openEvidenceDashboard",
                "title": "Agent Roster: Open Evidence Dashboard"
            }
        ],
        "languageModelTools": [
            {
                "name": "aroGetModelRecommendations",
                "displayName": "Read Aro model recommendations",
                "toolReferenceName": "aroGetModelRecommendations",
                "canBeReferencedInPrompt": true,
                "userDescription": "Read locally learned model recommendations for an activity, domain, and difficulty.",
                "modelDescription": "Read Aro's profile-local outcomes and cloud/local scope and priority for the given activity, domain, and difficulty. Uses exact and cautiously weighted related evidence, labels pooled evidence, and returns a bounded shortlist with an opaque per-recommendation callId for outcome correlation. For confirmed unavailability, requery with exact model/vendor pairs or provider IDs excluded; exclusions apply only to this request. Never bypass scope or priority. Does not read the user's chat model, send prompts to models, or change Aro's main model.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "activity": {
                            "type": "string",
                            "enum": [
                                "advise",
                                "implement",
                                "analyze",
                                "review",
                                "document",
                                "operate"
                            ]
                        },
                        "domain": {
                            "type": "string",
                            "enum": [
                                "coding",
                                "business",
                                "documentation-governance",
                                "infrastructure",
                                "cross-domain"
                            ]
                        },
                        "difficulty": {
                            "type": "string",
                            "enum": [
                                "simple",
                                "standard",
                                "complex"
                            ]
                        },
                        "excludedModels": {
                            "type": "array",
                            "maxItems": 20,
                            "description": "Exact model ID and vendor pairs confirmed unavailable for this dispatch; not persisted.",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 300
                                    },
                                    "vendor": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 300
                                    }
                                },
                                "required": [
                                    "id",
                                    "vendor"
                                ],
                                "additionalProperties": false
                            }
                        },
                        "excludedProviders": {
                            "type": "array",
                            "maxItems": 20,
                            "description": "Exact VS Code vendor IDs confirmed unavailable as a whole for this dispatch; not a billing-account identifier.",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 300
                            }
                        }
                    },
                    "required": [
                        "activity",
                        "domain",
                        "difficulty"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "name": "aroRecordModelOutcome",
                "displayName": "Record Aro model outcome",
                "toolReferenceName": "aroRecordModelOutcome",
                "canBeReferencedInPrompt": true,
                "userDescription": "Record a verified model outcome for an activity, domain, and difficulty.",
                "modelDescription": "Update Aro's local scorecard after an advisor or specialist call. Record success only after acceptance checks pass. Record failure only when concrete evidence attributes an incorrect, incomplete, acceptance-failing, or unsafe result to the requested model. Do not blame the model for missing input, incorrect routing, tool failure, rejected requests, or environment issues. Never send prompts or response text. Include optional measured duration or cost only when the runtime provides trustworthy values.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "activity": {
                            "type": "string",
                            "enum": [
                                "advise",
                                "implement",
                                "analyze",
                                "review",
                                "document",
                                "operate"
                            ]
                        },
                        "domain": {
                            "type": "string",
                            "enum": [
                                "coding",
                                "business",
                                "documentation-governance",
                                "infrastructure",
                                "cross-domain"
                            ]
                        },
                        "difficulty": {
                            "type": "string",
                            "enum": [
                                "simple",
                                "standard",
                                "complex"
                            ]
                        },
                        "modelId": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "callId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "description": "Opaque ID returned by the recommendation call for this dispatch."
                        },
                        "outcome": {
                            "type": "string",
                            "enum": [
                                "success",
                                "failure"
                            ]
                        },
                        "evidenceCode": {
                            "type": "string",
                            "enum": [
                                "acceptance_passed",
                                "incorrect",
                                "incomplete",
                                "acceptance_failed",
                                "unsafe"
                            ]
                        },
                        "worker": {
                            "type": "string",
                            "maxLength": 100
                        },
                        "agent": {
                            "type": "string",
                            "maxLength": 100
                        },
                        "metrics": {
                            "type": "object",
                            "properties": {
                                "durationMs": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 604800000
                                },
                                "costUsd": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1000000
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "required": [
                        "activity",
                        "domain",
                        "difficulty",
                        "modelId",
                        "outcome",
                        "evidenceCode"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "name": "aro_read_prior_assessment_store",
                "displayName": "Reuse prior assessment SQLite corpus",
                "toolReferenceName": "aro_read_prior_assessment_store",
                "canBeReferencedInPrompt": true,
                "userDescription": "With explicit file confirmation, search or list a prior assessment SQLite extracted-text corpus read-only.",
                "modelDescription": "After the user selects and confirms one exact SQLite file through a picker, optionally confirm one adjacent manifest JSON through a second picker. Reuse only the fixed documents/runs/docs_fts schema for bounded read-only FTS5 literal search or deterministic document listing. Accepts only operation, optional search text, cursor, and pageSize 1-20. Never accepts SQL or a path, never writes, and never claims comprehensive inventory. Results label prior local SQLite corpus reuse, PARTIAL/UNKNOWN coverage, canonical fields, conservative bounded excerpts or suppression, opaque store/run/native IDs, and an adjacent manifest as UNVERIFIED_NOT_CRYPTOGRAPHICALLY_BOUND_TO_DB unless a cryptographic DB binding is provided. Absolute paths, document rel_path values, and raw locators are never returned.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "operation": {
                            "type": "string",
                            "enum": [
                                "search",
                                "list"
                            ]
                        },
                        "query": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "cursor": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                        },
                        "pageSize": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20,
                            "default": 20
                        }
                    },
                    "required": [
                        "operation"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "name": "aro_write_evidence_batch",
                "displayName": "Write or read assessment evidence batches",
                "toolReferenceName": "aro_write_evidence_batch",
                "canBeReferencedInPrompt": true,
                "userDescription": "Write one bounded evidence batch under the standard active-workspace docs/project-assessment run allowlist, or read batch receipts for a run.",
                "modelDescription": "Use only for standard project-assessment evidence batches preauthorized in the active workspace. operation=write stores exactly one batch object (run_id, scope_id, source_key, batch_id, sufficiency COMPLETE|PARTIAL|UNKNOWN|BLOCKED, records[] where each record carries evidence_id and the same batch_id) beneath docs/project-assessment/<run_id>/evidence/<source_key>/<batch_id>.json. Standard full assessments do not require a separate evidence-save question, exact write-list prompt, or per-batch VS Code prompt. Re-sending identical content returns already_recorded; different content for an existing batch_id is refused and never overwritten. Returns a small receipt only, never the records. operation=status with runId returns batch receipts and the worst-status run sufficiency; a run is COMPLETE only when every batch is COMPLETE. Never writes outside the single open workspace folder, never uses extension storage, and never accepts absolute paths.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "operation": {
                            "type": "string",
                            "enum": [
                                "write",
                                "status"
                            ]
                        },
                        "runId": {
                            "type": "string",
                            "maxLength": 128,
                            "description": "Status only: the run folder name."
                        },
                        "batch": {
                            "type": "object",
                            "description": "Write only: one evidence batch object. Must include run_id, scope_id, source_key, batch_id, sufficiency, and records."
                        }
                    },
                    "required": [
                        "operation"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "name": "aro_read_evidence_batch_page",
                "displayName": "Read assessment evidence batch page",
                "toolReferenceName": "aro_read_evidence_batch_page",
                "canBeReferencedInPrompt": true,
                "userDescription": "Read one bounded page of normalized records from an evidence batch in the open project's docs/project-assessment folder. Read-only.",
                "modelDescription": "Read-only. Returns one bounded page of the actual normalized records of one evidence batch, identified by runId, sourceKey, and batchId, plus run/scope/source/batch identity, sufficiency, record_count, cursor, next_cursor, and final_page. Page through a batch by passing next_cursor as cursor until final_page is true; pages keep stored order. Use scopeId to assert the batch belongs to the expected scope. Reads only the open workspace folder's docs/project-assessment/<runId>/evidence/<sourceKey>/<batchId>.json. Malformed batches or records return an error naming the batch and record index; they are never skipped. Never writes, never accepts paths, never reads other batches, and never uses extension storage or source/ADO tools.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "runId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "sourceKey": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "batchId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "scopeId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "description": "Optional: the batch must belong to this scope or the read is refused."
                        },
                        "cursor": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0,
                            "description": "Zero-based record offset; pass the previous next_cursor."
                        },
                        "pageSize": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50,
                            "default": 20
                        }
                    },
                    "required": [
                        "runId",
                        "sourceKey",
                        "batchId"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "name": "aroGetSkillProcedure",
                "displayName": "Get Aro bundled skill procedure",
                "toolReferenceName": "aroGetSkillProcedure",
                "canBeReferencedInPrompt": true,
                "userDescription": "Return the bundled text of an Aro project-assessment procedure in bounded parts.",
                "modelDescription": "Return one bounded part of a bundled project-assessment procedure. Accepts only the listed skill names; any other value is rejected. The result states the part number and total; call again with the next part until the final part, then concatenate the verbatim segments in order for Aro to pass to a worker. Does not read arbitrary files, search, or grant tools.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "skill": {
                            "type": "string",
                            "enum": [
                                "project-evidence-ingestion",
                                "project-assessment"
                            ]
                        },
                        "part": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    "required": [
                        "skill"
                    ],
                    "additionalProperties": false
                }
            }
        ],
